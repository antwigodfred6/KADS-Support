# Copy to .env.local for local development. Never commit real values.

# Public URL used for canonical links, sitemap and Open Graph.
# Preview: the Vercel preview URL. Production (after approval): https://kadssupport.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Client to confirm" / "Placeholder" badges on unverified content.
# true for development and client-review previews; false for production.
NEXT_PUBLIC_SHOW_CONTENT_FLAGS=true

# Allow search engines to index the site. Leave unset (blocked) on previews.
# Set to true ONLY on the approved production deployment.
# ALLOW_INDEXING=true

# Contact form delivery. Not connected yet: no provider or recipient approved.
#   (unset) or none → form tells visitors to call/email instead (honest fallback)
#   log             → development only: validates, logs metadata, sends nothing
CONTACT_DELIVERY=log
